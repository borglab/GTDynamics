<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |  UR10e robot description for GTDynamics.                                        | -->
<!-- |                                                                                 | -->
<!-- |  Hand-converted from Universal_Robots_ROS2_Description, tag 4.4.0               | -->
<!-- |  (commit 81f7c9fe003c2f0e02eec5a7253f1b262ad38b61):                             | -->
<!-- |    urdf/ur_macro.xacro with config/ur10e/{default_kinematics,                   | -->
<!-- |    physical_parameters,joint_limits,visual_parameters}.yaml                     | -->
<!-- |  https://github.com/UniversalRobots/Universal_Robots_ROS2_Description           | -->
<!-- |  BSD-3-Clause, see LICENSE in this directory.                                   | -->
<!-- |                                                                                 | -->
<!-- |  Differences from the xacro output:                                             | -->
<!-- |  - base_link_inertia (base_link rotated by pi about z) is folded into           | -->
<!-- |    base_link, so the pi yaw moves into the shoulder_pan_joint origin.           | -->
<!-- |  - Mesh paths are relative (visual/*.dae, collision/*.stl).                     | -->
<!-- |  - ros2_control, transmission and gazebo blocks are omitted.                    | -->
<!-- |  - A fixed world link is added, as in ur5.urdf.                                 | -->
<!-- =================================================================================== -->
<robot name="ur10e">
  <!-- Nominal kinematics (DH):
       d1 = 0.1807, a2 = -0.6127, a3 = -0.57155,
       d4 = 0.17415, d5 = 0.11985, d6 = 0.11655 -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="visual/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="collision/base.stl"/>
      </geometry>
    </collision>
    <!-- Cylinder approximation: r = 0.075, l = 0.038 -->
    <inertial>
      <mass value="4.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0061063308908" ixy="0.0" ixz="0.0" iyy="0.0061063308908" iyz="0.0" izz="0.01125"/>
    </inertial>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0.1807"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="shoulder_link">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="visual/shoulder.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="collision/shoulder.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.369"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.021 -0.027 0.0"/>
      <inertia ixx="0.03408" ixy="0.00002" ixz="-0.00425" iyy="0.03529" iyz="0.00008" izz="0.02156"/>
    </inertial>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="upper_arm_link">
    <visual>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.1762"/>
      <geometry>
        <mesh filename="visual/upperarm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.1762"/>
      <geometry>
        <mesh filename="collision/upperarm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="13.051"/>
      <origin rpy="0 0 0" xyz="-0.2327 0.0 0.158"/>
      <inertia ixx="0.02814" ixy="0.00005" ixz="-0.01561" iyy="0.77068" iyz="0.00002" izz="0.76943"/>
    </inertial>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.6127 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="forearm_link">
    <visual>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.0393"/>
      <geometry>
        <mesh filename="visual/forearm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.0393"/>
      <geometry>
        <mesh filename="collision/forearm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.989"/>
      <origin rpy="0 0 0" xyz="-0.33155 0.0 0.068"/>
      <inertia ixx="0.01014" ixy="0.00008" ixz="0.00916" iyy="0.30928" iyz="0.0" izz="0.30646"/>
    </inertial>
  </link>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.57155 0 0.17415"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="wrist_1_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.135"/>
      <geometry>
        <mesh filename="visual/wrist1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.135"/>
      <geometry>
        <mesh filename="collision/wrist1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.1"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.018 0.007"/>
      <inertia ixx="0.00296" ixy="-0.00001" ixz="0.0" iyy="0.00222" iyz="-0.00024" izz="0.00258"/>
    </inertial>
  </link>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.11985 -2.458164590756244e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="wrist_2_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <mesh filename="visual/wrist2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <mesh filename="collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.98"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.018 -0.007"/>
      <inertia ixx="0.00296" ixy="-0.00001" ixz="0.0" iyy="0.00222" iyz="-0.00024" izz="0.00258"/>
    </inertial>
  </link>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.11655 -2.390480459346185e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 -0.0005 -0.1168"/>
      <geometry>
        <mesh filename="visual/wrist3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 -0.0005 -0.1168"/>
      <geometry>
        <mesh filename="collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.615"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.026"/>
      <inertia ixx="0.00040" ixy="0.0" ixz="0.0" iyy="0.00041" iyz="0.0" izz="0.00034"/>
    </inertial>
  </link>
  <!-- Force-torque sensor frame -->
  <link name="ft_frame"/>
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- Tool mounting flange (REP-103 orientation) -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- Frame coincident with all-zeros TCP on UR controller -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
</robot>
